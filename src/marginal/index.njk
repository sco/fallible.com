---
layout: marginal-base.njk
title: Archive
permalink: /marginal/
---

<h2 style="margin-top:0.5em;">All Posts</h2>
<p style="font-size:0.9em;color:#666;font-family:Arial,sans-serif;">A blog by Doug Raymond</p>

{% set currentYear = "" %}
{% for post in collections.marginalPosts %}
  {% set postYear = post.date.getFullYear() %}
  {% if currentYear != postYear %}
    {% set currentYear = postYear %}
    <h3 style="margin-top:2em;color:#5a1e00;border-bottom:1px solid #e0c8b8;padding-bottom:4px;">{{ postYear }}</h3>
  {% endif %}
  <p style="margin:0.5em 0;">
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <span style="color:#aaa;font-size:0.85em;font-family:Arial,sans-serif;"> — {{ post.date | postDate }}</span>
  </p>
{% endfor %}

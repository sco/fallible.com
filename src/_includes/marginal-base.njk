<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if title %} — {% endif %}Marginal Comments</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #9E3E13;
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 14px;
      color: #222;
    }

    .mc-outer { max-width: 760px; margin: 0; }

    /* ── Header: full width, 4 columns ── */
    .mc-header { display: flex; align-items: flex-end; }
    .mc-header img { display: block; }
    .mc-h-pen   { flex: 0 0 193px; }
    .mc-h-book  { flex: 1 1 0; overflow: hidden; }
    .mc-h-book img { width: 100%; height: 70px; object-fit: cover; object-position: left; }
    .mc-h-edge  { flex: 0 0 108px; }
    .mc-h-sidebar-top { flex: 0 0 144px; background: #9E3E13; }

    /* ── Two-column outer body ──
       Primary (pen+content+edge+bookbottom) sits next to Sidebar.
       align-items: flex-start means sidebar height won't stretch the primary. */
    .mc-outer-body { display: flex; align-items: flex-start; }

    /* Primary column: stacks the inner body row and bookbottom */
    .mc-primary { flex: 1 1 0; display: flex; flex-direction: column; overflow: hidden; }

    /* ── Inner body row ── */
    .mc-body { display: flex; align-items: stretch; flex: 1 1 auto; }

    /* Left decorative column */
    .mc-left {
      flex: 0 0 193px;
      background-image: url('/assets/textbackground.gif');
      background-repeat: repeat-y;
    }
    .mc-left img { display: block; }

    /* Main content column */
    .mc-main {
      flex: 1 1 0;
      background: #fff;
      padding: 0 16px 24px;
      min-width: 0;
    }
    .mc-branding { margin-bottom: 10px; }
    .mc-branding img { display: block; }

    .mc-main h2           { font-size: 1.2em; margin: 1em 0 0.2em; color: #5a1e00; }
    .mc-main h2 a         { color: #5a1e00; text-decoration: none; }
    .mc-main h2 a:hover   { text-decoration: underline; }
    .mc-main p            { line-height: 1.65; margin: 0.7em 0; }
    .mc-main a            { color: #7a3010; }
    .mc-main img          { max-width: 100%; height: auto; }
    .mc-post-meta         { font-size: 0.85em; color: #888; margin-bottom: 1.5em; font-family: Arial, sans-serif; }
    .mc-nav {
      margin-top: 2em;
      padding-top: 0.8em;
      border-top: 1px solid #e0c8b8;
      font-size: 0.85em;
      display: flex;
      justify-content: space-between;
      gap: 0.5em;
    }
    .mc-nav a { color: #7a3010; }

    /* Edge strip */
    .mc-edge {
      flex: 0 0 108px;
      background-image: url('/assets/edgebackground.jpg');
      background-repeat: repeat-y;
      overflow: hidden;
    }
    .mc-edge img { display: block; }

    /* Right sidebar: independent column, doesn't affect primary height */
    .mc-sidebar {
      flex: 0 0 144px;
      background: #9E3E13;
      color: #f5d8c0;
      padding: 4px 6px 8px;
      font-size: 11px;
      font-family: Arial, sans-serif;
      overflow-wrap: break-word;
      word-break: break-word;
      align-self: flex-start;
    }
    .mc-sidebar h1 {
      font-size: 11px;
      font-family: Arial, sans-serif;
      font-weight: bold;
      margin: 8px 0 2px;
      color: #fff;
    }
    .mc-sidebar a  { color: #ffcc99; }
    .mc-sidebar img { max-width: 100%; }
    .mc-sidebar td { font-size: 11px; font-family: Arial, sans-serif; vertical-align: top; }

    /* Book bottom + footer */
    .mc-bookbottom img { display: block; }
    .mc-footer {
      padding: 6px 8px;
      font-size: 11px;
      color: #ddd;
      font-family: Arial, sans-serif;
    }
    .mc-footer a { color: #ffcc99; }

    /* Mobile: drop decorative columns */
    @media (max-width: 620px) {
      .mc-h-edge, .mc-h-sidebar-top,
      .mc-left, .mc-edge, .mc-sidebar, .mc-bookbottom { display: none; }
      .mc-main { padding: 10px 14px 20px; }
    }
  </style>
  <link rel="icon" type="image/jpeg" href="/assets/M.png">

</head>
<body>
  <div class="mc-outer">

    <!-- Header: full-width, 4 columns (sidebar top is brown/empty) -->
    <div class="mc-header">
      <div class="mc-h-pen"><img src="/assets/pentop.jpg" width="193" height="70" alt=""></div>
      <div class="mc-h-book"><img src="/assets/booktop.jpg" alt=""></div>
      <div class="mc-h-edge"><img src="/assets/edgetopcorner.jpg" width="108" height="70" alt=""></div>
      <div class="mc-h-sidebar-top"></div>
    </div>

    <!-- Two-column outer body: primary (pen+content+edge+bookbottom) | sidebar -->
    <div class="mc-outer-body">

      <!-- Primary column -->
      <div class="mc-primary">
        <div class="mc-body">

          <!-- Left: pen/cup on paper background -->
          <div class="mc-left">
            <img src="/assets/pen-cup.jpg" alt="" width="193" height="588">
          </div>

          <!-- Center: blog content -->
          <div class="mc-main">
            <div class="mc-branding">
              <a href="/marginal/"><img src="/assets/marginalcomments.gif" width="256" height="73" alt="Marginal Comments" border="0"></a>
            </div>
            {{ content | safe }}
          </div>

          <!-- Edge strip -->
          <div class="mc-edge">
            <img src="/assets/edgetop.jpg" alt="" width="108" height="514">
          </div>

        </div><!-- end mc-body -->

        <!-- Book bottom image — inside primary so it appears after content, not after sidebar -->
        <div class="mc-bookbottom">
          <img src="/assets/bookbottom.jpg" width="637" height="97" alt="">
        </div>
      </div><!-- end mc-primary -->

      <!-- Right sidebar: independent, doesn't affect primary height -->
      <div class="mc-sidebar">

        <!-- Photos and blog links -->
        <a href="https://www.fallible.com/" title="Katy"><img src="/assets/katy.jpg" width="56" height="114" alt="Katy"></a><img src="/assets/doug.jpg" width="67" height="114" alt="Doug"><br>
        <a href="https://www.fallible.com/">fallible</a>
        <br><br>
        <img src="/assets/hishers2.gif" width="72" height="39" alt="His/Hers" align="right">The His/Hers icon at the end of a post means that Katy and I have attempted to write about the same topic or quote, without discussing before we write. I'm not sure what this will prove, other than being like-minded is apparently not a prerequisite to a happy marriage. ;)<br><br>

      </div><!-- end sidebar -->
    </div><!-- end mc-outer-body -->

    <div class="mc-footer">
      copyright 2008, ngenius media inc.
    </div>

  </div><!-- end outer -->
</body>
</html>

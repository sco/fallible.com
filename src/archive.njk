---
layout: base.njk
title: Fallible Archive
---

<h2>All Fallible Posts</h2>

<form action="https://www.google.com/search" method="get" style="margin: 1em 0 2em"
      onsubmit="this.q.value = 'site:fallible.com ' + this.q.value">
  <input type="search" name="q" placeholder="Search posts…" style="padding: 4px 8px; font-size: 0.95em; width: 200px;">
  <button type="submit" style="padding: 4px 10px; font-size: 0.95em;">Search</button>
</form>

{% set currentYear = "" %}
{% for post in collections.mainPosts %}
        {% set postYear = post.date.getFullYear() %}
        {% if currentYear != postYear %}
            {% set currentYear = postYear %}
            <h2 style="margin-top: 2em">{{ postYear }}</h2>
        {% endif %}

  <article style="margin-bottom: 1em">
    <h3 class="title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  </article>
{% endfor %}

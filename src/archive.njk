---
layout: base.njk
title: Fallible Archive
---

<h2>All Fallible Posts</h2>

<form class="search-form" action="https://www.google.com/search" method="get"
      onsubmit="this.q.value = 'site:fallible.com ' + this.q.value">
  <input type="search" name="q" placeholder="Search posts…">
  <button type="submit">Search</button>
</form>

{% set currentYear = "" %}
{% for post in collections.posts %}
  {% set postYear = post.date.getFullYear() %}
  {% if currentYear != postYear %}
    {% set currentYear = postYear %}
    <h2 class="archive-year">{{ postYear }}</h2>
  {% endif %}
  <article class="archive-entry">
    <h3 class="title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  </article>
{% endfor %}
